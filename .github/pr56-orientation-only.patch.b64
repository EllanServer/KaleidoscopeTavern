diff --git a/src/paper/java/com/github/ysbbbbbb/kaleidoscopetavern/paper/game/block/ConnectedBlockSemantics.java b/src/paper/java/com/github/ysbbbbbb/kaleidoscopetavern/paper/game/block/ConnectedBlockSemantics.java
